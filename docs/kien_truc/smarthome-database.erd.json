  "cards": [
    {
      "dot": "emerald",
      "title": "25 Bảng 3NF + WAL Mode + Foreign Keys ON",
      "items": [
        "Lưu tại smarthome.db với PRAGMA journal_mode = WAL và foreign_keys = ON (CASCADE DELETE)",
        "sessions, user_sessions và invites gắn đầy đủ khóa ngoại tới users; invites chỉ lưu token_hash SHA-256"
      ]
    },
    {
      "dot": "amber",
      "title": "3 Bể Tự Động Hóa Riêng Theo Người + Xác Nhận 4 Bước",
      "items": [
        "timers_pool + schedules, automation_rules, custom_commands cách ly theo owner_user_id",
        "pending_confirmations lưu server-side theo (owner_user_id, session_key), tự hết hạn sau 20 giây"
      ]
    },
    {
      "dot": "cyan",
      "title": "RBAC 3 Cấp & Chống Trùng Lịch Cấp 2 vs Cấp 1",
      "items": [
        "users.can_create_links mặc định = 0 với Gia đình (Cấp 2); Khách (Cấp 3) chỉ bật/tắt thiết bị (HTTP 403)",
        "Cấp 2 đặt hẹn giờ/lịch trùng Cấp 1 (±60s, múi giờ Asia/Saigon) bị từ chối HTTP 409 và ghi audit_logs 0 emoji"
      ]
    }
  ]
}
