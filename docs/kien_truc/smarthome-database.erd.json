  "cards": [
    {
      "dot": "emerald",
      "title": "Chuẩn Quan Hệ 3NF & ACID (WAL Mode)",
      "items": [
        "Lưu trữ tại simulator/data/smarthome.db với PRAGMA journal_mode = WAL và foreign_keys = ON",
        "Đánh 5 chỉ mục (INDEX) tăng tốc truy vấn lịch sử câu lệnh và bể hẹn giờ/luật < 1ms"
      ]
    },
    {
      "dot": "amber",
      "title": "Kiến Trúc Lai Server SQL <-> Mạch Flash JSON",
      "items": [
        "Trên Server: 8 bảng SQLite 3 lưu trữ bền vững toàn bộ lịch sử, vân giọng 26d/64d, Bể 1, Bể 2 và RAG",
        "Dưới Mạch ESP8266: Tự động kết xuất bản sao nhẹ (~1.4KB) nạp xuống 4MB LittleFS dùng khi Offline"
      ]
    },
    {
      "dot": "cyan",
      "title": "An Ninh Phân Quyền Offline Trên Bảng users & devices",
      "items": [
        "users.offline_allowed = 1 chỉ áp dụng cho Tầng 1 (Chủ nhà) & Tầng 2 (Gia đình); chặn Tầng 3 (Khách)",
        "devices.offline_controllable = 0 khóa cứng Cửa chính (D1) và Còi báo động (D8) khi mất Server"
      ]
    }
  ]
